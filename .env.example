# ============================================================
# Databricks Delta API — Environment Configuration
# ============================================================
# Copy this file to .env for local development.
# NEVER commit the .env file with real values.
# In production, store all secrets in Azure Key Vault.
# ============================================================

# --- External API Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ACTIVE=replace-with-generated-api-key
API_KEY_PREVIOUS=

# --- Cursor Encryption ---
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
CURSOR_ENCRYPTION_KEY_ACTIVE=replace-with-base64url-encoded-32-byte-key
CURSOR_ENCRYPTION_KEY_PREVIOUS=
CURSOR_TTL_SECONDS=86400

# --- Databricks Connection ---
# Get these from your Databricks workspace administrator:
DATABRICKS_SERVER_HOSTNAME=adb-<workspace-id>.<region>.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_CLIENT_ID=<service-principal-application-id>
DATABRICKS_CLIENT_SECRET=<service-principal-oauth-secret>

# --- Table Configuration ---
# Format: catalog.schema.table (three-level namespace)
TABLE_FQN=replace_catalog.replace_schema.replace_table
# Comma-separated column(s) that form a unique, non-null ordering key
ORDER_KEY_COLUMNS=replace_with_verified_unique_not_null_key

# --- Optional Tuning ---
MAX_PAGE_SIZE=1000
MAX_RESPONSE_BYTES=4194304
MAX_SOURCE_AGE_HOURS=0
QUERY_TIMEOUT_SECONDS=90
